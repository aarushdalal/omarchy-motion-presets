#!/usr/bin/env python3
"""Validated, serialized motion updates with rollback on compositor failure."""
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

PRESETS = 'default unfold liquid snap bloom ignition morph orbit parallax quantum cosmic tokyo ghost snappy cyberpunk fluid comic jelly matrix'.split()
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'hypr'
STATE = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'omarchy'
FILES = {'style': STATE / 'animation-style', 'intensity': STATE / 'animation-intensity', 'reduced-motion': STATE / 'reduced-motion'}
DEFAULTS = {'style': 'tokyo', 'intensity': 'balanced', 'reduced-motion': 'false'}

def current(key):
    try:
        value = FILES[key].read_text().strip()
        allowed = PRESETS if key == 'style' else ['subtle', 'balanced', 'expressive'] if key == 'intensity' else ['true', 'false']
        return value if value in allowed else DEFAULTS[key]
    except FileNotFoundError:
        return DEFAULTS[key]

def atomic(path, data, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data); stream.flush(); os.fsync(stream.fileno())
        os.chmod(name, mode)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)

def reload():
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'): return
    subprocess.run(['hyprctl', 'reload'], capture_output=True, check=True, timeout=10)
    result = subprocess.run(['hyprctl', 'configerrors'], capture_output=True, text=True, check=True, timeout=10)
    if result.stdout.strip() not in ('', 'ok'):
        raise RuntimeError('Compositor reported a configuration error; previous motion restored.')

def update(key, value):
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / '.motion-update.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        values = {k: current(k) for k in FILES}; values[key] = value
        source = CONFIG / 'animations' / (values['style'] + '.lua')
        if not source.is_file(): raise ValueError('Selected preset is not installed.')
        payload = source.read_text()
        if 'hl.animation(' not in payload: raise ValueError('Preset has no animation declarations.')
        multiplier = {'subtle': 0.8, 'balanced': 1, 'expressive': 1.25}[values['intensity']]
        payload = re.sub(r'\bspeed\s*=\s*(\d+(?:\.\d+)?)', lambda m: 'speed = ' + str(round(float(m[1]) * multiplier, 3)), payload)
        payload += '\n-- Persist accessibility mode across compositor reloads.\nhl.config({ animations = { enabled = ' + ('false' if values['reduced-motion'] == 'true' else 'true') + ' } })\n'
        target = CONFIG / 'animations.lua'; paths = [target, FILES[key]]
        before = {p: (p.read_bytes(), p.stat().st_mode & 0o777) if p.exists() else None for p in paths}
        try:
            atomic(target, payload.encode(), before[target][1] if before[target] else 0o644)
            reload()
            atomic(FILES[key], (value + '\n').encode())
        except Exception:
            for path, original in before.items():
                if original is None: path.unlink(missing_ok=True)
                else: atomic(path, *original)
            try: reload()
            except Exception: pass
            raise
        print('Motion updated:', key, value)

def main(args):
    dry_run = '--dry-run' in args; args = [x for x in args if x != '--dry-run']
    cmd = args[0] if args else 'current'
    if cmd == 'list': print('\n'.join(PRESETS)); return
    key = cmd if cmd in ('intensity', 'reduced-motion') else 'style'
    sub = args[1] if key != 'style' and len(args) > 1 else cmd if key == 'style' else 'get'
    if sub in ('current', 'get'):
        expected = args[2] if key != 'style' and len(args) > 2 else args[1] if key == 'style' and len(args) > 1 else None
        if expected is not None: return 0 if current(key) == expected else 1
        print(current(key)); return
    if sub == 'toggle' and key == 'reduced-motion': value = 'false' if current(key) == 'true' else 'true'
    elif sub == 'set':
        idx = 1 if key == 'style' else 2
        if len(args) <= idx: raise ValueError('A motion value is required.')
        value = args[idx]
    else: raise ValueError('Use current, list, set PRESET, intensity get/set or reduced-motion get/set/toggle.')
    allowed = PRESETS if key == 'style' else ['subtle', 'balanced', 'expressive'] if key == 'intensity' else ['true', 'false']
    if value not in allowed: raise ValueError('Invalid motion value.')
    if dry_run:
        source = CONFIG / 'animations' / ((value if key == 'style' else current('style')) + '.lua')
        if not source.is_file(): raise ValueError('Selected preset is not installed.')
        print('Validated motion update:', key, value)
    else: update(key, value)

if __name__ == '__main__':
    try: sys.exit(main(sys.argv[1:]))
    except (ValueError, OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr); sys.exit(1)
